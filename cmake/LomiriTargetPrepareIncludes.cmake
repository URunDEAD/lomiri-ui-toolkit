function(lomiri_target_prepare_includes target dest_dir)
    get_target_property(source_files ${target} SOURCES)
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/${dest_dir}/private")
    foreach(file ${source_files})
        if(${file} MATCHES "_p\.h$")
            file(COPY "${file}" DESTINATION "${CMAKE_CURRENT_BINARY_DIR}/${dest_dir}/private")
        elseif(${file} MATCHES "\.h$")
            file(COPY "${file}" DESTINATION "${CMAKE_CURRENT_BINARY_DIR}/${dest_dir}")
        endif()
    endforeach()
endfunction()
