msgstr "%1 से मान्य होना चाहिए एक मूल्य के लिए दावा: %2"

#: Lomiri/Components/plugin/ucarguments.cpp:520
#, qt-format
msgid "%1 is expecting additional arguments: %2"
msgstr "%1 को अतिरिक्त तर्कों की अपेक्षा है: %2"

