<RCC>
    <qresource prefix="/uc">
        <file alias="shaders/shape.frag">shaders/shape-qt5.frag</file>
        <file alias="shaders/shape_mipmap.frag">shaders/shape_mipmap-qt5.frag</file>
        <file alias="shaders/shape.vert">shaders/shape-qt5.vert</file>
        <file alias="shaders/shapeoverlay.frag">shaders/shapeoverlay-qt5.frag</file>
        <file alias="shaders/shapeoverlay_mipmap.frag">shaders/shapeoverlay_mipmap-qt5.frag</file>
        <file alias="shaders/shapeoverlay.vert">shaders/shapeoverlay-qt5.vert</file>
        <file alias="privates/shaders/frame.frag">privates/shaders/frame-qt5.frag</file>
        <file alias="privates/shaders/frame.vert">privates/shaders/frame-qt5.vert</file>
    </qresource>
</RCC>
